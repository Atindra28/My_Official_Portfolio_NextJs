# Resend API key. Server-only. Required for the contact form to deliver email.
# Never commit a real key. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=your_resend_api_key_here

# Inbox that receives contact form messages. Server-only. Never prefix with NEXT_PUBLIC_.
CONTACT_EMAIL=atindradubey2810@gmail.com

# Public site origin used for canonical URLs, Open Graph, sitemap, and JSON-LD.
# Example: https://your-domain.com
SITE_URL=http://localhost:43123

# Server-only key for the optional portfolio assistant model.
# OpenAI-compatible. Never use NEXT_PUBLIC_AI_API_KEY. The site answers from portfolio data when this is empty.
AI_API_KEY=

# Optional. Verified Resend sender, for example: Portfolio <hello@your-domain.com>
# If unset, the app uses Portfolio <onboarding@resend.dev>, which only delivers to the Resend account email.
# RESEND_FROM_EMAIL=

# Optional. OpenAI-compatible API base. Default: https://api.openai.com/v1
# AI_BASE_URL=

# Optional. Model id. Default: gpt-4o-mini
# AI_MODEL=
